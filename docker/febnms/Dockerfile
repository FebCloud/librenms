# 官方 LibreNMS 镜像 + FebCloud/librenms 分支相对该版本改动过的文件（FebNMS App 用到的接口和告警功能）。
# The official LibreNMS image plus the files the FebCloud/librenms fork changed against that
# release: the APIs and alert features the FebNMS app uses. The same build runs on FebNMS's
# own servers.
#
# src/ is generated by build-context.sh; build with:
#   docker/febnms/build-context.sh 26.11.0 && docker build -t febnms-librenms:26.11.0 docker/febnms
ARG LIBRENMS_VERSION=26.11.0
FROM librenms/librenms:${LIBRENMS_VERSION}

COPY --chown=1000:1000 src/ /opt/librenms/
# Route and config caches from the base image would hide the new routes.
RUN rm -f /opt/librenms/bootstrap/cache/*.php

ARG LIBRENMS_VERSION
ARG FORK_REVISION=unknown
LABEL org.opencontainers.image.title="LibreNMS for FebNMS" \
      org.opencontainers.image.description="Official LibreNMS image with the FebCloud/librenms changes used by the FebNMS app" \
      org.opencontainers.image.source="https://github.com/FebCloud/librenms" \
      org.opencontainers.image.revision="${FORK_REVISION}" \
      org.opencontainers.image.version="${LIBRENMS_VERSION}"
